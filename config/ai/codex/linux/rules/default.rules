prefix_rule(pattern=["gh", "run", "view"], decision="allow")
prefix_rule(pattern=["/usr/bin/zsh", "-lc", "UV_CACHE_DIR=/tmp/devtrack-uv-cache uv lock"], decision="allow")
prefix_rule(pattern=["/usr/bin/zsh", "-lc", "UV_CACHE_DIR=/tmp/devtrack-uv-cache uv sync"], decision="allow")
prefix_rule(pattern=["/usr/bin/zsh", "-lc", "UV_CACHE_DIR=/tmp/devtrack-uv-cache uv run python -c 'import psycopg2; print(psycopg2.__version__)'"], decision="allow")
prefix_rule(pattern=["/usr/bin/zsh", "-lc", "UV_CACHE_DIR=/tmp/devtrack-uv-cache uv run pytest backend/tests/test_client_event_store.py backend/tests/test_http_triggers.py -q"], decision="allow")
prefix_rule(pattern=["/usr/bin/zsh", "-lc", "GOCACHE=/tmp/devtrack-go-cache GOMODCACHE=/tmp/devtrack-go-mod go test ./internal/trigger"], decision="allow")
prefix_rule(pattern=["/usr/bin/zsh", "-lc", "UV_CACHE_DIR=/tmp/devtrack-uv-cache uv run pytest backend/tests/test_queue_gateway.py -x -vv"], decision="allow")

